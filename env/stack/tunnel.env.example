# Copy to tunnel.env (git-ignored) to use a Cloudflare named tunnel instead of quick tunnels.
# Token: Cloudflare dashboard > Zero Trust > Networks > Tunnels > Create (cloudflared) > copy the token
# from the "docker run ... --token <TOKEN>" command.
# Public hostnames for the tunnel (set in the same dashboard, Public Hostname tab):
#   CERTIFY_HOSTNAME -> HTTP certify-nginx:80
#   MIMOTO_HOSTNAME  -> HTTP mimoto-service:8099
# Use one-level subdomains (x.example.com): Universal SSL does not cover a.b.example.com.
CF_TUNNEL_TOKEN=
CERTIFY_HOSTNAME=ssi-issuer.arlabsnepal.com
MIMOTO_HOSTNAME=ssi-mimoto.arlabsnepal.com
