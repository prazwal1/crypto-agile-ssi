    "fullName": "${fullName}",
    "mobileNumber": "${mobileNumber}",
    "dateOfBirth": "${dateOfBirth}",
    "gender": "${gender}",
    "state": "${state}",
    "district": "${district}",
    "villageOrTown": "${villageOrTown}",
    "postalCode": "${postalCode}",
    "landArea": "${landArea}",
    "landOwnershipType": "${landOwnershipType}",
    "primaryCropType": "${primaryCropType}",
    "secondaryCropType": "${secondaryCropType}",
    "farmerID": "${farmerID}"
  },
